# Existing issuer secrets must be preserved, not regenerated during an upgrade.
CHAT_SSO_BRIDGE_SECRET=REPLACE_WITH_EXISTING_MAIN_SITE_SERVICE_SECRET
CHAT_OIDC_COOKIE_KEYS=["REPLACE_WITH_EXISTING_COOKIE_SIGNING_KEY"]
OPENWEBUI_OIDC_CLIENT_SECRET=REPLACE_WITH_INDEPENDENT_OPENWEBUI_CLIENT_SECRET
NEWAPI_OAUTH_CLIENT_SECRET=REPLACE_WITH_INDEPENDENT_NEWAPI_CLIENT_SECRET
CHAT_OIDC_SIGNING_JWKS_FILE=/run/secrets/signing.jwks.json
# Enable only after the reviewed Main profile overlay is deployed.
OIDC_MAIN_PROFILE_SYNC_ENABLED=false
