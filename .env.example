# Compose interpolation only. Store the filled file outside this checkout.
COMPOSE_PROJECT_NAME=parallellines-chat
CHAT_DATA_DIR=/data/parallellines/chat/data
CHAT_SECRETS_ENV=/data/parallellines/chat/secrets/runtime.env
CHAT_LOOPBACK_PORT=18080
EDGE_NETWORK=parallellines-edge
# Optional identity-bridge integration; replace the existing issuer service only.
BRIDGE_DATA_DIR=/data/parallellines/identity/data
BRIDGE_SECRETS_ENV=/data/parallellines/identity/secrets/runtime.env
BRIDGE_SIGNING_JWKS=/data/parallellines/identity/secrets/signing.jwks.json
BRIDGE_RELEASE=REPLACE_WITH_REVIEWED_GIT_COMMIT
