+		console.error(error);
+		if (error?.detail) throw error.detail;
+		return null;
+	}
+};
+
+/** 首页恢复登录状态专用；12 秒总时限，失败抛出含 HTTP 状态的错误，绝不清除令牌。 */
+export const getSessionUserForBootstrap = async (token: string) => {
+	const controller = new AbortController();
+	const timer = setTimeout(() => controller.abort(), 12000);
+	try {
+		const sessionUser = await requestSessionUser(token, controller.signal);
+		if (!sessionUser) throw new Error('Invalid session response');
+		return sessionUser;
+	} finally {
+		clearTimeout(timer);
+	}
 };
 
