+/** 共用原生会话读取；HTTP 状态仅作为失败依据，不把失败结果当作已登录用户。 */
+const requestSessionUser = async (token: string, signal?: AbortSignal) => {
+	const response = await fetch(`${WEBUI_API_BASE_URL}/auths/`, {
+		method: 'GET',
+		headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+		credentials: 'include',
+		...(signal ? { signal } : {})
+	});
+	if (!response.ok) {
+		const payload = await response.json().catch(() => null);
+		throw Object.assign(new Error(typeof payload?.detail === 'string' ? payload.detail : 'Session verification failed'), {
+			status: response.status,
+			detail: payload?.detail
+		});
+	}
+	return response.json();
+};
+
+/** 旧调用方保持原语义：网络异常返回 null，服务端 detail 错误继续向外抛出。 */
